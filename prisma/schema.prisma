generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "mysql"
  url = env("DATABASE_URL")
}
model User {
 id String @id @default(cuid())
 email String @unique @db.VarChar(191)
 name String
 password String
 role String @default("CUSTOMER")
 verified Boolean @default(false)
 createdAt DateTime @default(now())
 sessions Session[]
 addresses Address[]
 packages Package[]
 orders Order[]
 quotes Quote[]
}
model Session {
 id String @id
 userId String
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 expiresAt DateTime
 @@index([userId])
}
model Token {
 id String @id
 email String @db.VarChar(191)
 kind String
 expiresAt DateTime
 @@index([email,kind])
}
model RateLimit {
 id String @id
 count Int
 expiresAt DateTime
}
model Address {
 id String @id @default(cuid())
 userId String
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 label String
 data Json
 @@index([userId])
}
model Package {
 id String @id @default(cuid())
 userId String
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 label String
 data Json
 @@index([userId])
}
model Product {
 id String @id @default(cuid())
 slug String @unique @db.VarChar(191)
 name String
 description String @db.Text
 category String
 image String
 active Boolean @default(true)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 variants Variant[]
}
model Variant {
 id String @id @default(cuid())
 productId String
 product Product @relation(fields:[productId],references:[id],onDelete:Restrict)
 sku String @unique @db.VarChar(191)
 name String
 price Int
 stock Int @default(0)
 active Boolean @default(true)
 cartItems CartItem[]
 @@index([productId])
}
model CartItem {
 id String @id @default(cuid())
 owner String @db.VarChar(191)
 variantId String
 variant Variant @relation(fields:[variantId],references:[id],onDelete:Cascade)
 quantity Int
 @@unique([owner,variantId])
}
model Coupon {
 code String @id @db.VarChar(64)
 percent Int
 active Boolean @default(true)
 expiresAt DateTime?
}
model Order {
 id String @id @default(cuid())
 reference String @unique @db.VarChar(191)
 userId String?
 user User? @relation(fields:[userId],references:[id],onDelete:SetNull)
 email String
 status String @default("PENDING")
 paymentStatus String @default("PENDING")
 fulfillmentStatus String @default("UNFULFILLED")
 subtotal Int
 discount Int @default(0)
 shipping Int
 total Int
 currency String @default("ZAR")
 address Json
 items Json
 expiresAt DateTime
 stockReleased Boolean @default(false)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 payments Payment[]
 shipment Shipment?
 @@index([userId,createdAt])
 @@index([paymentStatus,expiresAt])
}
model Payment {
 id String @id
 orderId String
 order Order @relation(fields:[orderId],references:[id],onDelete:Restrict)
 amount Int
 status String
 payloadHash String
 createdAt DateTime @default(now())
 @@index([orderId])
}
model Shipment {
 id String @id @default(cuid())
 orderId String @unique
 order Order @relation(fields:[orderId],references:[id],onDelete:Restrict)
 waybill String @unique @db.VarChar(191)
 status String
 events Json
 updatedAt DateTime @updatedAt
}
model Quote {
 id String @id @default(cuid())
 reference String @unique @db.VarChar(191)
 userId String?
 user User? @relation(fields:[userId],references:[id],onDelete:SetNull)
 email String
 data Json
 status String @default("REQUESTED")
 amount Int?
 expiresAt DateTime?
 orderId String? @unique
 createdAt DateTime @default(now())
 @@index([userId,createdAt])
}
model Enquiry {
 id String @id @default(cuid())
 name String
 email String
 phone String
 message String @db.Text
 status String @default("NEW")
 createdAt DateTime @default(now())
}
model Setting {
 key String @id @db.VarChar(191)
 value Json
}
model Audit {
 id String @id @default(cuid())
 actor String
 action String
 target String
 createdAt DateTime @default(now())
 @@index([createdAt])
}
model Outbox {
 id String @id @default(cuid())
 recipient String
 subject String
 body String @db.Text
 sentAt DateTime?
 attempts Int @default(0)
 lockedUntil DateTime?
 createdAt DateTime @default(now())
 @@index([sentAt,lockedUntil])
}
model ReturnRequest {
 id String @id @default(cuid())
 orderId String
 userId String
 reason String @db.Text
 status String @default("REQUESTED")
 createdAt DateTime @default(now())
 @@index([userId])
}
model ShippingRule {
 id String @id @default(cuid())
 name String
 originPrefix String @db.VarChar(4)
 destinationPrefix String @db.VarChar(4)
 basePrice Int
 includedGrams Int
 maximumGrams Int
 perKg Int
 divisor Int @default(5000)
 fuelBps Int @default(0)
 taxBps Int @default(0)
 surcharge Int @default(0)
 active Boolean @default(false)
 createdAt DateTime @default(now())
 @@unique([originPrefix,destinationPrefix])
}
